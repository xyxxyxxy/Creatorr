# Host user for Creatorr volume writes (docker-compose `user:`).
# Match your host account: `id -u` / `id -g`
PUID=1000
PGID=1000

# Library root host path (Compose bind → container /library).
# First boot seeds /library when root_folders is empty. Add more roots in Settings → Library.
CREATORR_LIBRARY_ROOT=./var/library
# Example: use a NAS mount as the library root
# CREATORR_LIBRARY_ROOT=/mnt/nas/creatorr

# Optional. Compose defaults TZ to UTC when unset.
# TZ=UTC

# Optional. Override Compose sidecar URL defaults.
# Leave empty (or set blank) to disable that feature; omit the key to keep the Compose default.
# Point at an external provider instead of the Compose sidecars if you already run one elsewhere;
# then you can remove the unused creatorr-po-token / creatorr-flaresolverr services from Compose.
# CREATORR_POT_PROVIDER_URL=http://creatorr-po-token:4416
# CREATORR_FLARESOLVERR_URL=http://creatorr-flaresolverr:8191
# CREATORR_POT_PROVIDER_URL=
# CREATORR_FLARESOLVERR_URL=

# Optional. Trust X-Forwarded-Proto for Secure session cookies behind a reverse proxy.
# Only enable when the proxy strips/overwrites client-supplied X-Forwarded-Proto.
# CREATORR_TRUST_PROXY=1
