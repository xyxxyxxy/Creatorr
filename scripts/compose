#!/usr/bin/env bash
# Dev compose wrapper: refresh LAN public base URL into .env, then docker compose
# with docker-compose.dev.yml (includes prod base) + override.dev when present.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
"$ROOT/scripts/sync-dev-public-url.sh" >/dev/null
args=(-f "$ROOT/docker-compose.dev.yml")
if [[ -f "$ROOT/docker-compose.override.dev.yml" ]]; then
  args+=(-f "$ROOT/docker-compose.override.dev.yml")
fi
exec docker compose "${args[@]}" "$@"
